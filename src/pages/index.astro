---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { SITE } from '../config';
import { SERVICES } from '../data/services';

const apercu = SERVICES.slice(0, 6);
---
<Base
  title={`${SITE.nom} – Ménage Airbnb et nettoyage pour conciergeries (77, 91, 93)`}
  description="Ménage Airbnb et nettoyage entre deux séjours pour conciergeries et locations courte durée à Noisiel, Marne-la-Vallée, Corbeil-Essonnes et Stains. Équipe expérimentée, devis sur mesure."
>
  <section class="hero">
    <div class="container hero-grid">
      <div data-reveal>
        <p class="eyebrow">Ménage pour conciergeries & locations courte durée</p>
        <h1>Le ménage de vos locations courte durée, <span>entre de bonnes mains</span></h1>
        <p class="lead">
          Une équipe jeune et réactive, des agents d'entretien expérimentés : nous préparons vos logements
          entre chaque séjour pour que vous puissiez vous concentrer sur vos voyageurs et vos propriétaires.
        </p>
        <div class="btn-row">
          <a href="/devis/" class="btn btn-primary">Demander un devis <Icon name="arrow" size={18} /></a>
          <a href={`tel:${SITE.telephoneLien}`} class="btn btn-outline"><Icon name="phone" size={18} /> Nous appeler</a>
        </div>
        <ul class="hero-points">
          <li><Icon name="check" size={18} /> Produits fournis</li>
          <li><Icon name="check" size={18} /> Ponctuel ou régulier</li>
          <li><Icon name="check" size={18} /> Devis sur mesure</li>
        </ul>
      </div>
      <div class="hero-media" data-reveal data-reveal-delay="1">
        <img
          src="/images/chambre-draps-propres.jpg"
          alt="Chambre lumineuse avec un lit fait et des draps propres, prête à accueillir des voyageurs"
          width="1400" height="933" fetchpriority="high"
        />
        <div class="hero-badge">
          <span class="badge-icon"><Icon name="clock" /></span>
          <div><strong>Réponse rapide</strong><span>Un interlocuteur joignable, qui s'adapte à vos plannings.</span></div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="intro-titre">
    <div class="container split">
      <div class="split-media" data-reveal>
        <img src="/images/salon-appartement.jpg" alt="Séjour d'appartement propre et rangé, prêt pour une location courte durée" width="1400" height="933" loading="lazy" />
      </div>
      <div data-reveal data-reveal-delay="1">
        <p class="eyebrow">Qui sommes-nous</p>
        <h2 id="intro-titre">Un partenaire de confiance pour vos rotations</h2>
        <p>
          {SITE.nom} est une jeune entreprise de nettoyage qui travaille avec des agents d'entretien expérimentés :
          plus de 6 ans dans les conciergeries, les logements et les bureaux. Ils connaissent les exigences
          des locations courte durée : délais serrés, check-in à heure fixe, logement irréprochable à chaque arrivée.
        </p>
        <ul class="check-list">
          <li><Icon name="check" size={20} /> Un travail soigné et régulier, séjour après séjour</li>
          <li><Icon name="check" size={20} /> Des solutions pensées pour les conciergeries</li>
          <li><Icon name="check" size={20} /> Des tarifs compétitifs, établis sur devis</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section section-alt" aria-label="Chiffres clés">
    <div class="container">
      <div class="stats">
        <div class="stat" data-reveal><strong>6+ ans</strong><span>d'expérience terrain de nos agents en conciergeries, logements et bureaux</span></div>
        <div class="stat" data-reveal data-reveal-delay="1"><strong>3 départements</strong><span>Seine-et-Marne (77), Essonne (91) et Seine-Saint-Denis (93)</span></div>
        <div class="stat" data-reveal data-reveal-delay="2"><strong>Réactivité</strong><span>Un service client disponible, qui répond vite à vos demandes</span></div>
        <div class="stat" data-reveal data-reveal-delay="3"><strong>Sur mesure</strong><span>Ponctuel, régulier ou prestation test : vous choisissez</span></div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="services-titre">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Nos prestations</p>
        <h2 id="services-titre">Tout ce qu'il faut pour un logement prêt à accueillir</h2>
        <p>Du ménage de rotation au changement des draps, nous prenons en charge l'ensemble de la préparation de vos logements.</p>
      </div>
      <div class="grid grid-3">
        {apercu.map((s, i) => (
          <article class={`card ${s.phare ? 'card-featured' : ''}`} data-reveal data-reveal-delay={String(i % 3)}>
            <span class="card-icon"><Icon name={s.icon} size={26} /></span>
            <h3>{s.titre}</h3>
            <p>{s.texte}</p>
          </article>
        ))}
      </div>
      <p style="margin-top:28px"><a href="/prestations/" class="link-arrow">Voir toutes les prestations <Icon name="arrow" size={18} /></a></p>
    </div>
  </section>

  <section class="section section-alt" aria-labelledby="etapes-titre">
    <div class="container">
      <div class="section-head center" data-reveal>
        <p class="eyebrow">Comment ça marche</p>
        <h2 id="etapes-titre">Démarrer avec nous, en 4 étapes simples</h2>
      </div>
      <ol class="steps">
        <li class="step" data-reveal><h3>Vous nous présentez le logement</h3><p>Lien de l'annonce Airbnb, photos ou visite sur place.</p></li>
        <li class="step" data-reveal data-reveal-delay="1"><h3>Nous établissons un devis</h3><p>Une proposition sur mesure, selon le logement et vos besoins.</p></li>
        <li class="step is-highlight" data-reveal data-reveal-delay="2"><h3>Prestation test</h3><p>Un premier ménage payant pour découvrir notre travail et caler le temps nécessaire.</p></li>
        <li class="step" data-reveal data-reveal-delay="3"><h3>On s'occupe du reste</h3><p>Des ménages ponctuels ou réguliers, calés sur vos réservations.</p></li>
      </ol>
      <p style="margin-top:28px;text-align:center"><a href="/fonctionnement-tarifs/" class="link-arrow">En savoir plus sur notre fonctionnement <Icon name="arrow" size={18} /></a></p>
    </div>
  </section>

  <section class="section" aria-labelledby="zones-titre">
    <div class="container split reverse">
      <div class="split-media" data-reveal>
        <img src="/images/salle-de-bain.jpg" alt="Salle de bain moderne et impeccable avec douche à l'italienne" width="1400" height="933" loading="lazy" />
      </div>
      <div data-reveal data-reveal-delay="1">
        <p class="eyebrow">Zones d'intervention</p>
        <h2 id="zones-titre">Présents en Seine-et-Marne, Essonne et Seine-Saint-Denis</h2>
        <ul class="check-list" style="margin-bottom:24px">
          <li><Icon name="pin" size={20} /> Noisiel & Marne-la-Vallée (77)</li>
          <li><Icon name="pin" size={20} /> Corbeil-Essonnes & environs (91)</li>
          <li><Icon name="pin" size={20} /> Stains & environs (93)</li>
        </ul>
        <p class="muted">Vous gérez des logements dans une commune voisine ? Contactez-nous, nous étudions chaque demande.</p>
        <a href="/zones-intervention/" class="link-arrow">Voir la carte des zones <Icon name="arrow" size={18} /></a>
      </div>
    </div>
  </section>

  <CtaBand titre="Confiez-nous vos prochains ménages" />
</Base>
