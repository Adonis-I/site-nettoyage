---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { ZONES, link } from '../config';
---
<Base
  title="Zones d'intervention : Noisiel, Marne-la-Vallée, Corbeil-Essonnes, Stains"
  description="Ménage Airbnb et nettoyage pour conciergeries à Noisiel et Marne-la-Vallée (77), Corbeil-Essonnes (91), Stains (93) et communes voisines sur demande."
>
  <link slot="head" rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />

  <section class="page-hero">
    <div class="container" data-reveal>
      <p class="breadcrumb"><a href={link('/')}>Accueil</a> / Zones d'intervention</p>
      <p class="eyebrow">Zones d'intervention</p>
      <h1>Nous intervenons dans le 77, le 91 et le 93</h1>
      <p class="lead">Trois secteurs principaux en Île-de-France, et les communes voisines sur simple demande.</p>
    </div>
  </section>

  <section class="section" style="padding-top:24px">
    <div class="container">
      <div class="grid grid-4">
        {ZONES.map((z, i) => (
          <article class="card zone-card" data-reveal data-reveal-delay={String(i)}>
            <span class="card-icon"><Icon name="pin" size={26} /></span>
            <span class="zone-dep">{z.departement}</span>
            <h3>{z.titre}</h3>
            <p>{z.texte}</p>
          </article>
        ))}
        <article class="card card-featured zone-card" data-reveal data-reveal-delay="3">
          <span class="card-icon"><Icon name="target" size={26} /></span>
          <h3>Communes voisines sur demande</h3>
          <p>Votre logement est un peu plus loin ? Écrivez-nous : nous étudions chaque demande.</p>
        </article>
      </div>

      <div style="margin-top:40px" data-reveal>
        <h2 class="sr-only">Carte des zones d'intervention</h2>
        <div id="carte" class="map" data-zones={JSON.stringify(ZONES)} role="region" aria-label="Carte des zones d'intervention en Île-de-France">
          <div class="map-fallback">
            <p>Carte en cours de chargement… Nos secteurs : Noisiel & Marne-la-Vallée (77), Corbeil-Essonnes (91), Stains (93).</p>
          </div>
        </div>
        <p class="muted" style="font-size:.85rem;margin-top:8px">Les cercles indiquent nos secteurs principaux, à titre indicatif.</p>
      </div>
    </div>
  </section>

  <CtaBand titre="Votre logement est dans l'une de nos zones ?" texte="Demandez votre devis : nous vous répondons rapidement." />

  <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
  <script is:inline>
    (function () {
      var el = document.getElementById('carte');
      if (!el || !window.L) return;
      var zones = JSON.parse(el.dataset.zones || '[]');
      el.innerHTML = '';
      var map = L.map(el, { scrollWheelZoom: false });
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 18,
        attribution: '&copy; contributeurs <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>'
      }).addTo(map);
      var bounds = [];
      zones.forEach(function (z) {
        L.circle([z.lat, z.lng], { radius: 6000, color: '#0b4f5c', weight: 2, fillColor: '#0e6474', fillOpacity: 0.18 }).addTo(map);
        L.marker([z.lat, z.lng]).addTo(map).bindPopup('<strong>' + z.titre + '</strong><br>' + z.departement);
        bounds.push([z.lat, z.lng]);
      });
      map.fitBounds(bounds, { padding: [50, 50] });
    })();
  </script>
</Base>
