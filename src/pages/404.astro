---
import { link } from '../config';
import Base from '../layouts/Base.astro';
---
<Base title="Page introuvable" noindex>
  <section class="page-hero" style="min-height:50vh">
    <div class="container">
      <p class="eyebrow">Erreur 404</p>
      <h1>Cette page est introuvable</h1>
      <p class="lead">Le lien est peut-être erroné ou la page a été déplacée.</p>
      <div class="btn-row">
        <a href={link('/')} class="btn btn-primary">Retour à l'accueil</a>
        <a href={link('/devis/')} class="btn btn-outline">Demander un devis</a>
      </div>
    </div>
  </section>
</Base>
